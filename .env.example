# Copy these values into a local .env file for local development.
# On Render, set them in the service's Environment settings instead.
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/school_roster?retryWrites=true&w=majority
ADMIN_NAME=School Admin
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-64-random-hex-characters
NODE_ENV=development
